import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int W = sc.nextInt();
        int[] wt = new int[n];
        int[] val = new int[n];
        int[][] dp = new int[n + 1][W + 1];
        for (int i = 0; i < n; i++) {
            wt[i] = sc.nextInt();
            val[i] = sc.nextInt();
        }
        for (int i = 1; i <= n; i++) {
            for (int w = 0; w <= W; w++) {
                dp[i][w] = dp[i - 1][w];
                if (wt[i - 1] <= w) {
                    dp[i][w] = Math.max(dp[i][w],
                        val[i - 1] + dp[i - 1][w - wt[i - 1]]);
                }
            }
        }
        System.out.println(dp[n][W]);
        List<Integer> items = new ArrayList<>();
        int w = W;
        for (int i = n; i >= 1; i--) {
            if (dp[i][w] != dp[i - 1][w]) {
                items.add(i - 1);
                w -= wt[i - 1];
            }
        }
        Collections.sort(items);
        for (int i = 0; i < items.size(); i++) {
            if (i > 0) {
                System.out.print(" ");
            }
            System.out.print(items.get(i));
        }
        System.out.println();
        sc.close();
    }
}

