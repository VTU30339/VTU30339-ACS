import java.util.*;
public class Main {
    static class Node {
        int val, row, col;
        Node(int val, int row, int col) {
            this.val = val;
            this.row = row;
            this.col = col;
        }
    }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[][] a = new int[n][];
        PriorityQueue<Node> pq = new PriorityQueue<>(
            (x, y) -> Integer.compare(x.val, y.val)
        );
        for (int i = 0; i < n; i++) {
            int m = sc.nextInt();
            a[i] = new int[m];
            for (int j = 0; j < m; j++) {
                a[i][j] = sc.nextInt();
            }
            if (m > 0) {
                pq.offer(new Node(a[i][0], i, 0));
            }
        }
        List<Integer> merged = new ArrayList<>();
        while (!pq.isEmpty()) {
            Node cur = pq.poll();
            merged.add(cur.val);
            int next = cur.col + 1;
            if (next < a[cur.row].length) {
                pq.offer(new Node(a[cur.row][next], cur.row, next));
            }
        }
        int k = sc.nextInt();
        PriorityQueue<Integer> top = new PriorityQueue<>();
        for (int x : merged) {
            top.offer(x);
            if (top.size() > k) {
                top.poll();
            }
        }
        System.out.print("Merged:");
        for (int x : merged) {
            System.out.print(" " + x);
        }
        System.out.print("\nTopK:");
        List<Integer> result = new ArrayList<>();
        while (!top.isEmpty()) {
            result.add(top.poll());
        }
        Collections.reverse(result);
        for (int x : result) {
            System.out.print(" " + x);
        }
        System.out.println();
        sc.close();
    }
}

INPUT:
3 5
4 2 6 9 15
3 1 7 20
5 3 8 12 14 18
OUTPUT:
Merged:
1 2 3 6 7 8 9 12 14 15 18 20
TopK:
20 18 15 14 12
