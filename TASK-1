import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] vehicles = new int[n];
        for (int i = 0; i < n; i++) {
            vehicles[i] = sc.nextInt();
        }
        int k = sc.nextInt();
        if (k <= 0 || k > n) {
            System.out.println("Invalid window size");
            return;
        }
        int sum = 0;
        for (int i = 0; i < k; i++) {
            sum += vehicles[i];
        }
        int max = sum;
        for (int i = k; i < n; i++) {
            sum += vehicles[i] - vehicles[i - k];
            max = Math.max(max, sum);
        }
        System.out.println(max);
        sc.close();
    }
}

